# Copy this file to `.env.local` and fill in the blanks.
# `.env.local` is git-ignored. Never commit real values.

# ---- Database -------------------------------------------------------------
# Local development (no server required, SQLite file):
DATABASE_URL="file:./dev.db"
# Production (Neon / Supabase / Amazon RDS Postgres). Also change the
# `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/northpath?sslmode=require"

# ---- Public site ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.northpathcloud.ca"

# ---- Admin console --------------------------------------------------------
# Long random string. Generate with:  openssl rand -hex 32
ADMIN_TOKEN=""

# ---- Language model (optional — the assistant works without it) -----------
# Server-side only. Must NOT carry a NEXT_PUBLIC_ prefix or it ships to browsers.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---- Outbound email -------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Northpath Cloud <hello@northpathcloud.ca>"
MAIL_REPLY_TO="vidhyashankargoel1996@gmail.com"

# ---- CASL (Canada's Anti-Spam Legislation) --------------------------------
# s.6(2)(b) requires a mailing address in every commercial electronic message.
# s.11 requires a working unsubscribe mechanism valid for 60 days.
CASL_MAILING_ADDRESS="Northpath Cloud Inc., <street address>, Toronto, ON <postal code>, Canada"
CASL_UNSUBSCRIBE_BASE="https://www.northpathcloud.ca/unsubscribe"
