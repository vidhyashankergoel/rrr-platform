    "agents:tick": "tsx scripts/tick.ts",
    "agents:run": "tsx scripts/tick.ts --loop",
    "agents:status": "tsx scripts/tick.ts --status",
    "test:agents": "tsx scripts/ops-test.ts",
    "test": "tsx scripts/regression.ts",
    "test:bot": "tsx scripts/bot-battery.ts",
    "test:responsive": "tsx scripts/responsive-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:journey": "tsx scripts/journey-test.ts",
    "test:delivery": "tsx scripts/bridge-test.ts",
    "test:retrieval": "tsx scripts/retrieval-debug.ts",
    "sandbox": "tsx scripts/sandbox.ts",
    "sandbox:reset": "tsx scripts/sandbox.ts --reset",
    "test:e2e": "tsx scripts/sandbox.ts --reset --e2e",
    "test:attribution": "tsx scripts/attribution-test.ts",
    "test:booking": "tsx scripts/booking-test.ts",
    "test:chips": "tsx scripts/chip-test.ts",
